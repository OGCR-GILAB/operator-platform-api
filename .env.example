# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# e.g. https://operator.example.org (required when the service sits behind an HTTPS proxy)
DJANGO_CSRF_TRUSTED_ORIGINS=
# frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# set to 1 when the service runs behind a reverse proxy that terminates TLS
DJANGO_BEHIND_PROXY=0
LOG_LEVEL=INFO

# ---- API container ----
API_PORT=8000
GUNICORN_WORKERS=3

# ---- Database (PostgreSQL / PostGIS) ----
# DB_HOST applies to local runs (PyCharm, manage.py); inside the Docker network compose overrides it to "db".
# Use 127.0.0.1, not localhost: on Windows localhost resolves to IPv6 ::1 where Docker does not listen and the connection hangs.
POSTGRES_DB=operator
POSTGRES_USER=operator
POSTGRES_PASSWORD=operator
DB_HOST=127.0.0.1
DB_PORT=5432

# ---- DCR platform (OBP API) ----
# API host (the portal at portal.dcr.ogcr.tesobe.com is a different host and returns 404 for the API)
DCR_BASE_URL=https://dcr.ogcr.tesobe.com
DCR_API_VERSION=v6.0.0
# Consumer key/secret issued by DCR to this application (registered as a consumer)
DCR_CONSUMER_KEY=
DCR_CONSUMER_SECRET=
DCR_TIMEOUT=15
# Optional DCR service account with the CanCreateResetPasswordUrl role; enables password reset e-mails
DCR_SERVICE_USERNAME=
DCR_SERVICE_PASSWORD=
# How long (seconds) a validated DCR token is cached so DCR is not called on every request
DCR_AUTH_CACHE_SECONDS=300
# 1 = serve built-in sample certification schemes when DCR returns none or an error (demo phase)
DCR_REFERENCE_SAMPLE_FALLBACK=1

# ---- GeoDjango on Windows (leave empty on Linux/Docker) ----
GDAL_LIBRARY_PATH=C:/Program Files/QGIS 3.44.12/bin/gdal313.dll
GEOS_LIBRARY_PATH=C:/Program Files/QGIS 3.44.12/bin/geos_c.dll

# ---- Documents ----
DOCUMENT_MAX_SIZE_MB=25
# DOCUMENT_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tif,tiff,doc,docx,xls,xlsx,csv,txt,zip,geojson,json,kml,gpkg
